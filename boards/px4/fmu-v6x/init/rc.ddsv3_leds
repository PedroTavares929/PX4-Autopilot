#!/bin/sh
#
# px4_fmu-v6x_ddsv3_leds: one WS2812B per motor arm on AUX1-4 (TIM5, DMA1 TIM5_UP).
# Runs as rc.additional_init, after rc.board_defaults and before px4io, dshot and
# pwm_out: motor_leds reserves TIM5 here, so AUX1-4 are no longer PWM outputs.
# Leave PWM_AUX_FUNC1-4 Disabled: with a function on any of them motor_leds does not
# start and the outputs keep their function (also with PWM_AUX_TIM0 set to DShot).
#------------------------------------------------------------------------------

motor_leds start
